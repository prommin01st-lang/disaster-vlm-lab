# คัดลอกเป็น .env (gitignored) แล้วแก้ค่า — docker compose อ่านไฟล์นี้อัตโนมัติ · ห้าม commit .env
# profile ที่ใช้เมื่อสั่ง `docker compose up` เฉย ๆ: cpu หรือ cuda (ต้องมี nvidia-container-toolkit)
COMPOSE_PROFILES=cpu

# token อ่าน HF repo private Petanque/dvl-qwen3.5-2b-gguf — ใช้เฉพาะ service `models` ตอนไฟล์ GGUF ยังไม่มี
# (มีไฟล์ใน DVL_MODELS_DIR ครบแล้วเว้นว่างได้) · ไม่ถูก bake ลง image
HF_TOKEN=

# ถ้าตั้ง ทุก /v1/* ต้องมี header X-API-Key — ควรตั้งเสมอเมื่อ DVL_API_BIND ไม่ใช่ 127.0.0.1
DVL_API_KEY=

# พอร์ตของ API บนเครื่อง host (container ฟัง 8092) · 127.0.0.1 = เรียกได้จากเครื่องนี้เท่านั้น
DVL_API_BIND=127.0.0.1
DVL_API_PORT=8092

# โฟลเดอร์ GGUF บน host (mount เข้า llama แบบ read-only) · uid:gid ที่ service models ใช้เขียนไฟล์ลงโฟลเดอร์นี้
DVL_MODELS_DIR=./models/gguf
DVL_UID=1000
DVL_GID=1000

# threshold ของกติกา abstain — 3.2e-5 tune กับ Q4_K_M + llama.cpp b10909 Vulkan (ดู README "Docker")
DVL_ABSTAIN_T=3.2e-5
# วินาทีที่ API รอ llama-server ต่อคำขอ (CPU ช้ากว่า GPU มาก — เพิ่มได้ถ้าเจอ 504)
DVL_TIMEOUT=60
